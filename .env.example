FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this

# MySQL Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=quizdb
MYSQL_USER=quizuser
MYSQL_PASSWORD=quizpassword

# Database URL (constructed from MySQL variables above)
DATABASE_URL=mysql+pymysql://quizuser:quizpassword@db:3306/quizdb

ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-opus-5-5
# LLM provider (default: anthropic). Everything here can also be changed from
# Admin > Settings without restarting; values saved there take precedence.
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=http://ollama:11434/v1   # OpenAI, Mistral, Gemini, OpenRouter, Ollama...
# AI_API_KEY=
# AI_MODEL=llama3.1
ADMIN_DEFAULT_PASSWORD=changeme123

# Address the app port (5006) is published on. Default 127.0.0.1: only the
# host reverse proxy reaches it. 0.0.0.0 exposes it directly (plain HTTP).
# APP_BIND=127.0.0.1

# Security: Comma-separated list of allowed hostnames (empty = allow all)
# Example: ALLOWED_HOSTS=BrainNotFound.example.com,localhost
ALLOWED_HOSTS=

# Session cookie security - set to 'true' only if you have HTTPS configured
# If you're using HTTP (not HTTPS), keep this as 'false' or login won't work!
SESSION_COOKIE_SECURE=false

# Email SMTP Configuration
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your_smtp_password
MAIL_DEFAULT_SENDER=BrainNotFound <noreply@example.com>

# Public address of the site, used for links in emails sent in the background
# (grader digest). Example: PUBLIC_URL=https://quiz.example.com
PUBLIC_URL=
# Grader digest: at most one email per quiz every N minutes (default 30)
# GRADER_DIGEST_MINUTES=30

# Encryption key for sensitive settings (FTP password, etc.)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If not set, derived from SECRET_KEY
SETTINGS_ENCRYPTION_KEY=

# Backups kept on the server (manual backups without FTP, pre-restore and
# pre-deploy snapshots) and maximum size of a backup restored from the browser
# BACKUP_LOCAL_DIR=backups
# BACKUP_MAX_UPLOAD_MB=2048
