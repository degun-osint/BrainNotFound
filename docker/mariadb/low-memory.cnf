# MariaDB tuned for small servers (mounted by docker-compose.yml).
# The whole database of an organization with 600 learners and 6000 graded
# papers is ~2 MB: a 64 MB InnoDB cache keeps it all in memory.
# Big installations can raise innodb_buffer_pool_size or remove the mount.
[mariadb]
innodb_buffer_pool_size = 64M
innodb_log_buffer_size = 8M
key_buffer_size = 8M
max_connections = 30
table_open_cache = 200
table_definition_cache = 400
thread_cache_size = 4
tmp_table_size = 16M
max_heap_table_size = 16M
skip-name-resolve
